    "# Línea vertical del Cut-off óptimo\n",
    "plt.vlines(x=cutoff_optimo, ymin=acum_morosos[idx_optimo], ymax=acum_buenos[idx_optimo], \n",
    "           color='#2ca02c', linestyle='--', lw=2.5, \n",
