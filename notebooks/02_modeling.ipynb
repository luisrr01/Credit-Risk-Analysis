    "nominal_cols = ['person_home_ownership', 'loan_intent']\n",
    "\n",
    "# Aplicamos pd.get_dummies a X_train\n",
    "X_train = pd.get_dummies(X_train, columns=nominal_cols, drop_first=True, dtype=int)\n",
